DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# Production HTTPS (set origins for your hostname)
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Postgres on Render/Railway; omit for local SQLite dev
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DATABASE_SSL_REQUIRE=1

# AI (website + content tools fall back gracefully if unset)
OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: email ping when someone uses the public site contact form
# LEAD_NOTIFY_EMAIL=you@yourdomain.com
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
